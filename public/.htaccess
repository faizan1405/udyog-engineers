# ----------------------------------------------------------------------
# UDYOG ENGINEERS INDIA — Hostinger / Apache Server Configuration
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --------------------------------------------------------------------
  # 1. PERMANENT REDIRECTS (HTTP 301) — CATEGORY RESTRUCTURE
  # --------------------------------------------------------------------
  # Forestry Items -> Camera Trap
  RewriteRule ^categories/forestry-items/?$ /categories/camera-trap [R=301,L]
  RewriteRule ^categories/forestry-items\.html$ /categories/camera-trap [R=301,L]

  # Geological Compass -> Geological Equipment
  RewriteRule ^categories/geological-compass/?$ /categories/geological-equipment [R=301,L]
  RewriteRule ^categories/geological-compass\.html$ /categories/geological-equipment [R=301,L]

  # Legacy Garmin category alias -> GPS
  RewriteRule ^categories/garmin/?$ /categories/gps [R=301,L]
  RewriteRule ^categories/garmin\.html$ /categories/gps [R=301,L]

  # --------------------------------------------------------------------
  # 2. CLEAN URL & DIRECTORY ROUTING (for Next.js Static HTML Export)
  # --------------------------------------------------------------------
  # If request matches a directory with index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # If request matches a .html file directly
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

</IfModule>

# Fallback Redirects if mod_rewrite is disabled
<IfModule !mod_rewrite.c>
  RedirectPermanent /categories/forestry-items /categories/camera-trap
  RedirectPermanent /categories/geological-compass /categories/geological-equipment
  RedirectPermanent /categories/garmin /categories/gps
</IfModule>

# Security & Header Optimization
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct access to sensitive environment files
<FilesMatch "^(\.env.*|\.git.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Cache Optimization for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
